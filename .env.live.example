# Cấu hình LLM thật cho test live (provider gate M1+).
# Cách dùng:
#   cp .env.live.example .env.live     # .env.live đã nằm trong .gitignore
#   điền giá trị thật, rồi chạy:
#   cargo test --test m1_live_provider -- --ignored --nocapture
#
# Biến môi trường cùng tên luôn ưu tiên hơn giá trị trong file.
# Đổi đường dẫn file bằng LIVE_ENV_FILE=/path/to/file.
# Định dạng: KEY=VALUE mỗi dòng, '#' là comment, có thể bọc giá trị bằng "..." hoặc '...'.

# Endpoint OpenAI-compatible (không kèm user:pass hay query).
G0_OPENAI_BASE_URL=http://192.168.1.157:20128/v1
G0_OPENAI_MODEL=gh/gpt-4o-mini
G0_OPENAI_API_KEY=
 